{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoro-finds",
  "main": "_worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zoro-finds-db",
      "database_id": "7da79bfc-f958-417e-952d-7b3522791256"
    }
  ],
  "vars": {
    "RAZORPAY_KEY_ID": "rzp_test_TZbI6Firui4Ixz"
  }
}
